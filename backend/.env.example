PORT=3000

# Optional Angular browser build directory; unset or blank keeps API-only startup.
# FRONTEND_DIST=

LOG_LEVEL=info # debug / info / warn / error

DATASTORE=json # json / mongodb
MONGODB_URI=mongodb://localhost:27017 # only used if DATASTORE=mongodb
MONGODB_DATABASE=dependency_parser # only used if DATASTORE=mongodb

DEPENDENCY_SCAN_ENABLED=true # true / false
DEPENDENCY_SCAN_INTERVAL_MINUTES=15 # only used if DEPENDENCY_SCAN_ENABLED=true

# Optional read-only access token for HTTPS github.com repositories.
GITHUB_TOKEN=<token>

GIT_MAX_CONCURRENCY=64 # shared Git command limit and background worker count
DEPENDENCY_RESOLUTION_RETRIES=2 # retries after the first confirmed missing dependency-ref attempt
NPM_RANGE_RESOLUTION_TTL_MINUTES=1440 # refresh inferred npm range resolutions after one day
