{
  "name": "backend",
  "version": "0.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "lint": "eslint src tests --max-warnings=0",
    "lint:fix": "npm run lint -- --fix",
    "start": "node dist/index.js",
    "test": "node --test",
    "test:coverage": "npm run build && c8 node --test",
    "verify": "npm run lint && npm run test:coverage"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "description": "",
  "dependencies": {
    "cors": "^2.8.6",
    "dependency-parser": "file:..",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "fast-xml-parser": "^5.11.2",
    "mongodb": "^7.7.0",
    "semver": "^7.8.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/semver": "^7.8.0",
    "c8": "^12.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "test-exclude@8": {
      "glob": "^14.0.3",
      "minimatch": "^11.0.4"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
